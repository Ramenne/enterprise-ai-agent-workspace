{
  "name": "employeeclient-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "员工客户端——员工个人 APP 手机客户端（Vue 3 + TypeScript + Vite；iOS PWA / Android Capacitor 薄壳）",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node dev/run-backend.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "cap:sync": "cap sync android",
    "test": "node --test dev/*.test.mjs",
    "test:policy": "node --test dev/notifyPolicy.test.mjs",
    "build:connector-ui": "esbuild connector-mac/web/app.js --bundle --minify --outfile=connector-mac/web/app.bundle.js",
    "build:server": "esbuild server/business/web-push-entry.cjs --bundle --platform=node --format=cjs --outfile=server/business/web-push.bundle.cjs",
    "build:gateway": "node dev/build-runtime-gateway.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.4",
    "@noble/hashes": "^2.0.1",
    "jsqr": "^1.4.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-pwa": "^0.20.0",
    "vue-tsc": "^2.0.13"
  }
}
