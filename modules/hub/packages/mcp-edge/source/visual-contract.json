      "additionalProperties": false
    }
  },
  {
    "name": "visual.video.preview",
    "description": "预览视频工作流，参数使用video.capabilities及调用说明；不会提交。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
