[
  {
    "name": "visual.capabilities",
    "description": "读取统一绘画与视频能力；生图和视频只用ComfyUI Cloud，AutoDL仅用于LoRA训练。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.image.preview",
    "description": "预览Krea2 Cloud生图参数、LoRA和供应商；零散与批量统一Cloud，不等待AutoDL。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "width": {
          "type": "integer",
          "minimum": 512,
          "maximum": 2048,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 512,
          "maximum": 2048,
          "multipleOf": 16
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lora_id": {
          "type": "string",
          "format": "uuid"
        },
        "lora_strength": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "demand": {
          "type": "string",
          "enum": [
            "sporadic",
            "batch"
          ]
        },
        "generation_authorized": {
          "type": "boolean"
        },
        "estimated_credits": {
          "type": "number"
        },
        "budget_credits": {
          "type": "number"
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.image.generate",
    "description": "通过ComfyUI Cloud提交一张Krea2图或视频参考图；稳定UUID重试只查原任务，历史任务仍按原供应商观察。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "width": {
          "type": "integer",
          "minimum": 512,
          "maximum": 2048,
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "minimum": 512,
          "maximum": 2048,
          "multipleOf": 16
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lora_id": {
          "type": "string",
          "format": "uuid"
        },
        "lora_strength": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "demand": {
          "type": "string",
          "enum": [
            "sporadic",
            "batch"
          ]
        },
        "generation_authorized": {
          "type": "boolean"
        },
        "estimated_credits": {
          "type": "number"
        },
        "budget_credits": {
          "type": "number"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "prompt",
        "generation_authorized",
        "estimated_credits",
        "budget_credits",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.lora.resolve",
    "description": "Civitai链接预检，由执行供应商解析；中枢不访问Civitai。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.lora.import",
    "description": "固定Civitai版本并导入ComfyUI Cloud，用于加载LoRA生图；AutoDL仅保留训练用途。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "comfy_cloud",
            "autodl"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "url",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.lora.list",
    "description": "列出当前成员LoRA及绑定；Cloud ready不代表AutoDL已就绪。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.lora.get",
    "description": "查询原LoRA导入，保留原ID，不重新导入。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.job.get",
    "description": "查询原图/视频任务；不会重发；可查询已有Cloud API的历史本地任务ID。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
