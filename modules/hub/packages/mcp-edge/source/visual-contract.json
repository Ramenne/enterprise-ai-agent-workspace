    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video"
          ]
        }
      },
      "required": [
        "id",
        "asset_id",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "visual.video.capabilities",
