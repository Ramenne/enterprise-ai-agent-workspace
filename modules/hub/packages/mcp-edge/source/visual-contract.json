  {
    "name": "visual.training.plan",
    "description": "AutoDL专用LoRA训练计划；不租卡、不执行训练，执行能力需另行验证。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "output_name": {
          "type": "string"
        },
        "max_train_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
